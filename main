#include <iostream>

makeMtx(mtx, m, n);

int main(
{
  size_t m = 0;
  size_t n = 0;
  std::cin >> m >> n;
  if (!std::cin)
  {
    return 1;
  }

  int ** mtx = nullptr;
  makeMtx(mtx, m, n);
}

for (size_t i = 0; i< m * n; ++i)
{
  mtx[i / m][i % m] = 0;
}

if (std::cin.fail())
{
  rmMtx(mtx, m)
  return 1;
}

transpose(mtx)
for (size_t i = 0; i < m * n; ++i)
{
  std::cout << mtx[i / m][i % m] << '\n';
}

rmMtx(mtx, m);
}

//message: main implementation and function definition